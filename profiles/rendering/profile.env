# Profile settings for rendering applications: games, engines, renderers, simulations and
# visualisations whose performance is frame time. Read by run-local.sh after .github/.env and
# before the target's own target.env, which overrides anything here. Engine profiles
# (e.g. unity) build on this one with PROFILE_BASE=rendering.

# Rendered-output check: run.sh writes one screenshot per view; the pipeline compares B's
# screenshots with A's and caps a KEEP at INVESTIGATE when the picture changes beyond the
# A-vs-A noise. Set VISUAL_CHECK=off in target.env for a project without a picture to compare.
VISUAL_CHECK=on
